DB_HOST=
DB_PORT=5432

REDIS_URL=redis://localhost:6379

LOW_STOCK_THRESHOLD=5
TAX_RATE=0.08
DELIVERY_FEE=9.99
FREE_DELIVERY_THRESHOLD=99

STRIPE_SECRET_KEY=mock_secret_key
STRIPE_WEBHOOK_SECRET=mock_webhook_secret
STRIPE_PUBLISHABLE_KEY=mock_publishable_key

